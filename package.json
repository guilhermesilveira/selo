{
  "name": "@guilhermesilveira/selo",
  "version": "0.1.1",
  "description": "selo de qualidade guilherme raiz — a small linter built around a goal-driven, deterministic ratchet. Rules return per-unit measurements; the engine handles ratcheting toward a goal you set.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "selo": "./dist/cli/selo.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/selo.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run lint",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.59.1",
    "globby": "^16.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.7.0",
    "eslint": "^9.39.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
